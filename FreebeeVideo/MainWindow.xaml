<Window x:Class="FreebeeVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FreebeeVideo.ViewModels"
        mc:Ignorable="d"
        Title="FreebeeVideo – Video Trimmer &amp; Joiner"
        Height="720" Width="1200" MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title bar -->
            <RowDefinition Height="52"/>
            <!-- Main content -->
            <RowDefinition Height="*"/>
            <!-- Status bar -->
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ TITLE BAR ══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="20" Height="20" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="FreebeeVideo"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  Video Trimmer &amp; Joiner"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ MAIN CONTENT ═══════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <!-- Left panel: clip list -->
                <ColumnDefinition Width="280" MinWidth="200"/>
                <!-- Splitter -->
                <ColumnDefinition Width="4"/>
                <!-- Right panel: player + controls -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT PANEL ─────────────────────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="CLIP QUEUE"
                                   Style="{StaticResource Label}"
                                   FontSize="12"/>
                        <TextBlock Text="Add videos, reorder, then export."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Clip list -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Clips}"
                             SelectedItem="{Binding SelectedClip}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:hh\:mm\:ss} total">
                                                <Binding Path="Duration"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <!-- Trim badge -->
                                    <Border Background="{StaticResource AccentBrush}"
                                            CornerRadius="3" Padding="5,2"
                                            HorizontalAlignment="Left" Margin="0,3,0,0"
                                            Visibility="{Binding IsTrimmed, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="10" Foreground="White">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="✂ {0:hh\:mm\:ss\.fff} – {1:hh\:mm\:ss\.fff}">
                                                    <Binding Path="StartTime"/>
                                                    <Binding Path="EndTime"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Clip action buttons -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button Content="➕  Add Video(s)"
                                Command="{Binding AddClipCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,0,6" HorizontalAlignment="Stretch"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="▲ Up"
                                    Command="{Binding MoveUpCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                            <Button Grid.Column="2" Content="▼ Down"
                                    Command="{Binding MoveDownCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </Grid>
                        <Button Content="🗑  Remove Selected"
                                Command="{Binding RemoveClipCommand}"
                                Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Grid splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- ── RIGHT PANEL ────────────────────────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Video player -->
                    <RowDefinition Height="*"/>
                    <!-- Timeline -->
                    <RowDefinition Height="Auto"/>
                    <!-- Controls area -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Video player -->
                <Border Grid.Row="0" Background="Black">
                    <Grid>
                        <!-- MediaElement -->
                        <MediaElement x:Name="MediaPlayer"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      Stretch="Uniform"
                                      MediaOpened="MediaPlayer_MediaOpened"
                                      MediaEnded="MediaPlayer_MediaEnded"
                                      MediaFailed="MediaPlayer_MediaFailed"
                                      Volume="{Binding Volume, Mode=TwoWay}"/>

                        <!-- No-clip placeholder -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding HasSelectedClip, Converter={StaticResource InvertedBoolToVis}}">
                            <TextBlock Text="▶" FontSize="48" Foreground="#40FFFFFF"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Add a video and select it to preview"
                                       Foreground="#60FFFFFF" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Timeline row -->
                <Grid Grid.Row="1" Background="{StaticResource SurfaceBrush}" Margin="0,1,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Seek slider -->
                    <Slider Grid.Row="0"
                            x:Name="SeekSlider"
                            Minimum="0"
                            Maximum="{Binding MediaDuration.TotalSeconds}"
                            Value="{Binding MediaPosition.TotalSeconds, Mode=OneWay}"
                            Thumb.DragStarted="SeekSlider_DragStarted"
                            Thumb.DragCompleted="SeekSlider_DragCompleted"
                            Margin="12,10,12,2"
                            IsEnabled="{Binding HasSelectedClip}"/>

                    <!-- Time labels -->
                    <Grid Grid.Row="1" Margin="12,0,12,8">
                        <TextBlock Text="{Binding MediaPosition, Converter={StaticResource TimeSpanToString}}"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding MediaDuration, Converter={StaticResource TimeSpanToString}}"
                                   FontFamily="Consolas" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>

                <!-- ── Controls area ─────────────────────────────────────────── -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Playback controls + volume -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <!-- Play / Pause -->
                            <Button Grid.Column="0"
                                    x:Name="PlayPauseButton"
                                    Content="▶  Play"
                                    Command="{Binding PlayPauseCommand}"
                                    Click="PlayPauseButton_Click"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="100"
                                    IsEnabled="{Binding HasSelectedClip}"/>

                            <!-- Volume -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Slider Width="100"
                                        Minimum="0" Maximum="1" Value="{Binding Volume}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Trim controls -->
                        <Border Grid.Row="1"
                                Background="{StaticResource BackgroundDarkBrush}"
                                CornerRadius="8" Padding="14,10"
                                Margin="0,0,0,12"
                                IsEnabled="{Binding HasSelectedClip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Start time -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TRIM START" Style="{StaticResource Label}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 x:Name="TrimStartBox"
                                                 Text="{Binding SelectedClip.StartTime, Converter={StaticResource TimeSpanToString}, TargetNullValue='00:00:00.000'}"
                                                 LostFocus="TrimStartBox_LostFocus"/>
                                        <Button Grid.Column="2"
                                                Content="Set"
                                                Command="{Binding SetTrimStartCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,6"
                                                ToolTip="Set trim start to current playback position"/>
                                    </Grid>
                                </StackPanel>

                                <!-- End time -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TRIM END" Style="{StaticResource Label}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 x:Name="TrimEndBox"
                                                 Text="{Binding SelectedClip.EndTime, Converter={StaticResource TimeSpanToString}, TargetNullValue='00:00:00.000'}"
                                                 LostFocus="TrimEndBox_LostFocus"/>
                                        <Button Grid.Column="2"
                                                Content="Set"
                                                Command="{Binding SetTrimEndCommand}"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,6"
                                                ToolTip="Set trim end to current playback position"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Clear trim -->
                                <Button Grid.Column="4"
                                        Content="✕ Clear Trim"
                                        Command="{Binding ClearTrimCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>

                        <!-- Export row -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Progress bar + label -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <ProgressBar Value="{Binding ExportProgress}"
                                             Maximum="100"
                                             Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding ExportProgress, Converter={StaticResource DoubleToPercent}}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0"
                                           Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <!-- Cancel -->
                            <Button Grid.Column="2"
                                    Content="Cancel"
                                    Command="{Binding CancelExportCommand}"
                                    Style="{StaticResource DangerButton}"
                                    Visibility="{Binding IsExporting, Converter={StaticResource BoolToVis}}"/>

                            <!-- Export -->
                            <Button Grid.Column="4"
                                    Content="🎬  Trim &amp; Export"
                                    Command="{Binding ExportCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="20,10"
                                    FontSize="14"
                                    Visibility="{Binding IsExporting, Converter={StaticResource InvertedBoolToVis}}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════ STATUS BAR ══════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,0">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
