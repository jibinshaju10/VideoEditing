<Window x:Class="FreebeeVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FreebeeVideo – Video Trimming &amp; Joining"
        Height="600" Width="820"
        MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <!-- Colours -->
        <SolidColorBrush x:Key="AccentBrush"       Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentHoverBrush"  Color="#6D28D9"/>
        <SolidColorBrush x:Key="SurfaceBrush"      Color="#27273A"/>
        <SolidColorBrush x:Key="BorderBrush"       Color="#3D3D5C"/>
        <SolidColorBrush x:Key="TextPrimary"       Color="#F1F0FF"/>
        <SolidColorBrush x:Key="TextSecondary"     Color="#A0A0C0"/>
        <SolidColorBrush x:Key="DangerBrush"       Color="#EF4444"/>
        <SolidColorBrush x:Key="SuccessBrush"      Color="#22C55E"/>

        <!-- Button style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox style -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background"        Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"        Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="8,6"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- ListBox style -->
        <Style x:Key="VideoList" TargetType="ListBox">
            <Setter Property="Background"      Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="4"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer>
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Padding"    Value="6,4"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd"
                                            Background="Transparent"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#3D3D6C"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#35355C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl style -->
        <Style x:Key="AppTabControl" TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent"/>
                            <Border Grid.Row="1"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0,8,8,8"
                                    Padding="20">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppTabItem" TargetType="TabItem">
            <Setter Property="Foreground"   Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"     Value="14"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E2E45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar style -->
        <Style x:Key="AppProgress" TargetType="ProgressBar">
            <Setter Property="Height"          Value="6"/>
            <Setter Property="Background"      Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="3"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Padding="24,16,24,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="8"
                        Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                    <TextBlock Text="▶" FontSize="16" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FreebeeVideo"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Free video trimming &amp; joining"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Main content ── -->
        <TabControl Grid.Row="1" Margin="20,0,20,16"
                    Style="{StaticResource AppTabControl}"
                    x:Name="MainTabControl">

            <!-- ════════ TRIM TAB ════════ -->
            <TabItem Header="✂  Trim Video" Style="{StaticResource AppTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Input file -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="INPUT VIDEO" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TrimInputPath" Grid.Column="0"
                                     Style="{StaticResource InputBox}"
                                     IsReadOnly="True" Margin="0,0,8,0"
                                     Text="No file selected…"
                                     Foreground="{StaticResource TextSecondary}"/>
                            <Button Grid.Column="1" Content="Browse…"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="TrimBrowseInput_Click" Width="90"/>
                        </Grid>
                    </StackPanel>

                    <!-- Start / End time -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="START TIME  (hh:mm:ss)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TrimStart" Style="{StaticResource InputBox}"
                                     Text="00:00:00" TextChanged="TrimTime_TextChanged"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="→" FontSize="18"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,0,0,8"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="END TIME  (hh:mm:ss)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TrimEnd" Style="{StaticResource InputBox}"
                                     Text="00:00:10" TextChanged="TrimTime_TextChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- Output file -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                        <TextBlock Text="OUTPUT FILE" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TrimOutputPath" Grid.Column="0"
                                     Style="{StaticResource InputBox}"
                                     IsReadOnly="True" Margin="0,0,8,0"
                                     Text="No file selected…"
                                     Foreground="{StaticResource TextSecondary}"/>
                            <Button Grid.Column="1" Content="Save As…"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="TrimBrowseOutput_Click" Width="90"/>
                        </Grid>
                    </StackPanel>

                    <!-- Trim button -->
                    <Button Grid.Row="3" x:Name="TrimButton"
                            Content="✂  Trim Video"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Width="160"
                            Click="TrimButton_Click" IsEnabled="False"/>

                    <!-- Progress -->
                    <StackPanel Grid.Row="4" Margin="0,16,0,0">
                        <ProgressBar x:Name="TrimProgress"
                                     Style="{StaticResource AppProgress}"
                                     Margin="0,0,0,6"
                                     Visibility="Collapsed"/>
                        <TextBlock x:Name="TrimStatus"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ════════ JOIN TAB ════════ -->
            <TabItem Header="⊕  Join Videos" Style="{StaticResource AppTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- List header + buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="INPUT VIDEOS  (drag to reorder)"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ Add"
                                Style="{StaticResource SecondaryButton}"
                                Click="JoinAdd_Click" Padding="12,6"/>
                        <Button Grid.Column="3" Content="↑ Up"
                                Style="{StaticResource SecondaryButton}"
                                Click="JoinMoveUp_Click" Padding="12,6"
                                x:Name="JoinUpButton" IsEnabled="False"/>
                        <Button Grid.Column="5" Content="↓ Down"
                                Style="{StaticResource SecondaryButton}"
                                Click="JoinMoveDown_Click" Padding="12,6"
                                x:Name="JoinDownButton" IsEnabled="False"/>
                        <Button Grid.Column="7" Content="✕ Remove"
                                Style="{StaticResource DangerButton}"
                                Click="JoinRemove_Click" Padding="12,6"
                                x:Name="JoinRemoveButton" IsEnabled="False"/>
                    </Grid>

                    <!-- File list -->
                    <ListBox Grid.Row="1" x:Name="JoinFilesList"
                             Style="{StaticResource VideoList}"
                             Margin="0,0,0,14"
                             MinHeight="120"
                             SelectionChanged="JoinFilesList_SelectionChanged"/>

                    <!-- Output file -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                        <TextBlock Text="OUTPUT FILE" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="JoinOutputPath" Grid.Column="0"
                                     Style="{StaticResource InputBox}"
                                     IsReadOnly="True" Margin="0,0,8,0"
                                     Text="No file selected…"
                                     Foreground="{StaticResource TextSecondary}"/>
                            <Button Grid.Column="1" Content="Save As…"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="JoinBrowseOutput_Click" Width="90"/>
                        </Grid>
                    </StackPanel>

                    <!-- Join button -->
                    <Button Grid.Row="3" x:Name="JoinButton"
                            Content="⊕  Join Videos"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Width="160"
                            Click="JoinButton_Click" IsEnabled="False"/>

                    <!-- Progress -->
                    <StackPanel Grid.Row="4" Margin="0,16,0,0">
                        <ProgressBar x:Name="JoinProgress"
                                     Style="{StaticResource AppProgress}"
                                     Margin="0,0,0,6"
                                     Visibility="Collapsed"/>
                        <TextBlock x:Name="JoinStatus"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ── Status bar ── -->
        <Border Grid.Row="2"
                Background="#16162A"
                Padding="24,6">
            <TextBlock x:Name="FooterStatus"
                       Text="Ready – select a tab to get started."
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="11"/>
        </Border>
    </Grid>
</Window>
